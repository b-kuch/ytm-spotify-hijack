<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Switch
            android:id="@+id/enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enabled"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            style="@style/Hint"
            android:text="@string/enabled_hint" />

        <Switch
            android:id="@+id/handle_regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/handle_regular"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            style="@style/Hint"
            android:text="@string/handle_regular_hint" />

        <TextView
            android:id="@+id/delay_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <SeekBar
            android:id="@+id/delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            style="@style/Hint"
            android:text="@string/delay_hint" />

        <TextView
            style="@style/Header"
            android:text="@string/setup_header" />

        <TextView
            style="@style/Hint"
            android:text="@string/setup_body" />

        <TextView
            android:id="@+id/link_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/open_link_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_link_settings" />

        <TextView
            style="@style/Header"
            android:text="@string/spotify_header" />

        <TextView
            style="@style/Hint"
            android:text="@string/spotify_body" />

        <EditText
            android:id="@+id/client_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/client_id"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/client_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/client_secret"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            style="@style/Header"
            android:text="@string/test_header" />

        <EditText
            android:id="@+id/test_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/test_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/paste"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paste" />

            <Button
                android:id="@+id/test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/test" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
